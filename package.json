{
  "name": "datalynx",
  "version": "0.0.0",
  "description": "A searchable suggestions popover for inputs with a datalist, with a sheet on phones and 22 languages.",
  "keywords": [
    "autocomplete",
    "datalist",
    "combobox",
    "typeahead",
    "custom-element",
    "web-component",
    "popover",
    "vanilla-js"
  ],
  "private": false,
  "type": "module",
  "main": "src/datalynx.js",
  "types": "src/datalynx.d.ts",
  "style": "src/datalynx.css",
  "jsdelivr": "dist/datalynx.min.js",
  "unpkg": "dist/datalynx.min.js",
  "author": "Peter Petkov",
  "license": "MIT",
  "homepage": "https://github.com/peter-petkov/datalynx#readme",
  "bugs": {
    "url": "https://github.com/peter-petkov/datalynx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-petkov/datalynx.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "burrowkit": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check:types": "tsc -p types"
  }
}